# Render environment variables for Research Website
# Replace placeholder values before deploying. Do NOT commit secrets to source control.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Backend public URL (used by frontend)
BACKEND_URL=https://research-group-backend-11j3.onrender.com

# Recommended: single JSON env var containing all member credentials (one-line JSON).
# Example (replace the example entries with real values):
# RESEARCH_CREDENTIALS=[{"username":"R.Sablang","password":"Redgelson Sablang","email":"redgelson@sablang.test","fullName":"Redgelson Sablang","role":"Researcher","isAdmin":true},{"username":"M.M.Sulit","password":"Mary Margarette Sulit","email":"mary@sulit.test","fullName":"Mary Margarette Sulit","role":"Research Leader","isAdmin":true}]
# If your Render dashboard requires no surrounding quotes, paste the JSON exactly as a single line.
RESEARCH_CREDENTIALS=[{"username":"R.Sablang","password":"Redgelson Sablang","email":"redgelson@sablang.test","fullName":"Redgelson Sablang","role":"Researcher","isAdmin":true},{"username":"M.M.Sulit","password":"Mary Margarette Sulit","email":"mary@sulit.test","fullName":"Mary Margarette Sulit","role":"Research Leader","isAdmin":true}]

# Legacy/fallback single admin pair (optional)
RESEARCH_LOGIN_USERNAME=admin
RESEARCH_LOGIN_PASSWORD=changeme

# Alternative: per-member env vars (if you prefer not to use JSON)
# RESEARCH_MEMBER_1_USERNAME=R.Sablang
# RESEARCH_MEMBER_1_PASSWORD=Redgelson Sablang
# RESEARCH_MEMBER_1_EMAIL=redgelson@sablang.test

# Other environment flags
NODE_ENV=production
PORT=10000

# End of file
